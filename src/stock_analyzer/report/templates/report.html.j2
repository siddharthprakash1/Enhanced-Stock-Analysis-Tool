<!DOCTYPE html><html><head><meta charset="utf-8"><style>{{ css }}</style></head>
<body>

<div class="masthead">
  <span class="firm">EQUITY RESEARCH</span>
  <span class="mh-right">{{ as_of }}</span>
</div>

<div class="title-row">
  <div class="title-left">
    <h1 id="doctitle">{{ company or symbol }}</h1>
    <div class="tick">{{ symbol }}</div>
  </div>
  <div class="rating-box rating-{{ recommendation }}">
    <div class="rb-rating">{{ recommendation|upper }}</div>
    <div class="rb-conf">{{ confidence }} conviction</div>
    <table class="rb-tbl">
      {% if price %}<tr><td>Last Price</td><td>{{ price }}</td></tr>{% endif %}
      {% if targets %}<tr><td>DCF Fair Value</td><td>{{ targets.base }}</td></tr>
      <tr><td>Implied</td><td>{{ targets.base_upside }}</td></tr>{% endif %}
    </table>
  </div>
</div>

{% if kpis %}<div class="keystats">
  {% for k in kpis %}<div class="ks"><span class="ks-l">{{ k.label }}</span><span class="ks-v">{{ k.display }}</span></div>{% endfor %}
</div>{% endif %}

{% for s in sections %}
<section class="rpt">
  <h2><span class="num">{{ loop.index }}</span>{{ s.title }}</h2>
  {% for p in s.paras %}<p>{{ p }}</p>{% endfor %}
  {% for c in s.charts %}<figure><img src="{{ c.src }}"/><figcaption>{{ c.caption }}</figcaption></figure>{% endfor %}
</section>
{% endfor %}

{% if fundamentals_table or risk_table or valuation_table or sensitivity %}
<section class="rpt">
  <h2><span class="num sym">&#9635;</span>Financial Detail</h2>
  <div class="two-col">
    {% if fundamentals_table %}<div><h3>Fundamentals</h3><table class="data"><tbody>{% for r in fundamentals_table %}<tr><td>{{ r.label }}</td><td>{{ r.value }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
    {% if risk_table %}<div><h3>Risk Metrics</h3><table class="data"><tbody>{% for r in risk_table %}<tr><td>{{ r.label }}</td><td>{{ r.value }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
  </div>
  {% if valuation_table %}<h3>Valuation</h3><table class="data"><tbody>{% for r in valuation_table %}<tr><td>{{ r.label }}</td><td>{{ r.value }}</td></tr>{% endfor %}</tbody></table>{% endif %}
  {% if sensitivity %}<h3>DCF Enterprise Value Sensitivity ($B)</h3>
  <table class="sens">
    <thead><tr><th>Growth&nbsp;\&nbsp;WACC</th>{% for w in sensitivity.waccs %}<th>{{ (w*100)|round|int }}%</th>{% endfor %}</tr></thead>
    <tbody>{% for row in sensitivity.grid %}<tr><th>{{ (sensitivity.growths[loop.index0]*100)|round|int }}%</th>{% for v in row %}<td>{{ "{:,.0f}".format(v / 1000000000) }}</td>{% endfor %}</tr>{% endfor %}</tbody>
  </table>{% endif %}
</section>
{% endif %}

{% if news %}
<section class="rpt"><h2><span class="num sym">&#9636;</span>Recent Headlines</h2>
  <ul class="news">{% for n in news %}<li>{{ n.title }}</li>{% endfor %}</ul>
</section>
{% endif %}

<section class="rpt verify"><h2><span class="num sym">&#10003;</span>Verification Audit</h2>
  <p class="vsum"><b>{{ audit.supported }}</b> supported &middot; <b class="bad">{{ audit.contradicted }}</b> contradicted &middot; <b class="warn">{{ audit.unsupported }}</b> unsupported <span class="muted">&mdash; {{ audit.total_claims }} atomic claims reconciled against the computed ground-truth</span></p>
  {% if residual %}<table class="data"><thead><tr><th>Status</th><th>Detail</th></tr></thead><tbody>{% for v in residual %}<tr><td class="st-{{ v.status }}">{{ v.status }}</td><td>{{ v.note }}</td></tr>{% endfor %}</tbody></table>
  {% else %}<p class="ok">&#10003; Every numeric claim reconciled against the ground-truth &mdash; no unresolved items.</p>{% endif %}
</section>

{% if metrics_appendix %}
<section class="rpt"><h2><span class="num sym">A</span>Appendix &mdash; Computed Metrics</h2>
  <div class="two-col">
  {% for cat in metrics_appendix %}<div><h3>{{ cat.category }}</h3><table class="data"><tbody>{% for r in cat.rows %}<tr><td>{{ r.label }}</td><td>{{ r.value }}</td></tr>{% endfor %}</tbody></table></div>{% endfor %}
  </div>
</section>
{% endif %}

<section class="disclosures">
  <h4>Disclosures</h4>
  <p>This report was generated by the Enhanced Stock Analysis Tool for research and educational purposes only and does not constitute investment advice, an offer, or a solicitation to buy or sell any security. Market data is sourced from yFinance as of {{ as_of }}. The narrative is produced by a language model; every numeric claim in it is reconciled against the independently computed metrics shown above (see the Verification Audit). DCF fair values are model estimates under stated assumptions and are highly sensitive to inputs. Past performance is not indicative of future results.</p>
</section>

</body></html>
