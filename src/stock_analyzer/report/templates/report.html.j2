<!DOCTYPE html><html><head><meta charset="utf-8"><style>{{ css }}</style></head><body>
<header class="cover">
  <div class="eyebrow">EQUITY RESEARCH{% if as_of %} · {{ as_of }}{% endif %}</div>
  <h1>{{ symbol }}</h1>
  <span class="rec rec-{{ recommendation }}">{{ recommendation|upper }}<span class="conf"> · {{ confidence }} confidence</span></span>
</header>
<div class="strip">
  {% for k in kpis %}<div class="kpi"><div class="k-label">{{ k.label }}</div><div class="k-val">{{ k.display }}</div></div>{% endfor %}
</div>
{% for s in sections %}
<section class="report-section">
  <h2>{{ s.title }}</h2>
  {% for para in s.paras %}<p>{{ para }}</p>{% endfor %}
  {% for c in s.charts %}<figure><img src="{{ c.src }}"/><figcaption>{{ c.caption }}</figcaption></figure>{% endfor %}
</section>
{% endfor %}
<section class="report-section verify">
  <h2>Verification Audit</h2>
  <p class="vsum"><span class="ok">{{ audit.supported }} supported</span> · <span class="bad">{{ audit.contradicted }} contradicted</span> · <span class="warn">{{ audit.unsupported }} unsupported</span> <span class="muted">(of {{ audit.total_claims }} atomic claims checked against the computed ground-truth)</span></p>
  {% if residual %}<table class="verdicts"><thead><tr><th>Status</th><th>Detail</th></tr></thead><tbody>
    {% for v in residual %}<tr><td class="st-{{ v.status }}">{{ v.status }}</td><td>{{ v.note }}</td></tr>{% endfor %}
  </tbody></table>{% else %}<p class="all-clear">&#10003; Every numeric claim reconciled against the ground-truth — no unresolved items.</p>{% endif %}
</section>
<footer>Data via yFinance{% if as_of %} · as of {{ as_of }}{% endif %} · Generated by the Enhanced Stock Analysis Tool. For research and educational purposes only — not financial advice.</footer>
</body></html>
